# Host-side port overrides. Container-internal ports never change; only what the
# stack publishes on this machine does. Defaults (in compose.yaml) follow GR1
# Appendix B -- override here when something else on the host already holds one.
#
# Diagnose collisions with:  python mosaic.py check-ports

# 9001 is held by an unrelated `lakehouse-control-plane` container on this machine.
MINIO_CONSOLE_PORT=9101
